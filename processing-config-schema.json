{
  "x-exports": ["types", "validate"],
  "title": "ProcessingConfig",
  "type": "object",
  "layout": "tabs",
  "required": ["dataset", "fields", "label", "filename"],
  "allOf": [
    {
      "title": "Dataset",
      "x-i18n-title": { "fr": "Jeu de données" },
      "properties": {
        "dataset": {
          "type": "object",
          "title": "Existing dataset",
          "x-i18n-title": { "fr": "Jeu de donnée existant" },
          "properties": {
            "id": {
              "type": "string",
              "title": "Identifier",
              "x-i18n-title": { "fr": "Identifiant" }
            },
            "href": {
              "type": "string",
              "title": "URL"
            },
            "title": {
              "type": "string",
              "title": "Title",
              "x-i18n-title": { "fr": "Titre" }
            }
          },
          "layout": {
            "getItems": {
              "url": "${context.dataFairUrl}/api/v1/datasets?q={q}&select=id,title&${context.ownerFilter}",
              "itemsResults": "data.results",
              "itemTitle": "item.title",
              "itemKey": "item.id"
            }
          }
        }
      }
    },
    {
      "title": "Parameters",
      "x-i18n-title": { "fr": "Paramètres" },
      "properties": {
        "fields": {
          "type": "array",
          "title": "Dataset columns",
          "x-i18n-title": { "fr": "Colonnes du jeu de données" },
          "items": {
            "type": "object",
            "properties": {
              "key": { "type": "string" },
              "label": { "type": "string" },
              "type": { "type": "string" }
            }
          },
          "layout": {
            "getItems": {
              "url": "${rootData.config.dataset.href}/schema?calculated=false",
              "itemTitle": "item.label",
              "itemKey": "item.key"
            }
          },
          "default": []
        },
        "format": {
          "type": "array",
          "title": "Output file formats",
          "x-i18n-title": { "fr": "Format de sortie des fichiers" },
          "description": "Select multiple formats to generate multiple files",
          "x-i18n-description": { "fr": "Selectionner plusieurs format pour générer plusieurs fichiers" },
          "layout": "select",
          "items": {
            "type": "string",
            "enum": [
              "csv",
              "parquet",
              "xlsx",
              "geojson",
              "pmtiles",
              "shp",
              "gpkg"
            ]
          },
          "default": ["csv"]
        },
        "filename": {
          "type": "string",
          "title": "File name (without extension)",
          "x-i18n-title": { "fr": "Nom du fichier (sans l'extension)" },
          "default": "export"
        },
        "label": {
          "type": "string",
          "title": "Attachment label",
          "x-i18n-title": { "fr": "Libellé de la pièce jointe" },
          "default": "Export"
        },
        "filters": {
          "$ref": "#/definitions/filters"
        }
      }
    }
  ],
  "definitions": {
    "filters": {
      "title": "Predefined filters",
      "x-i18n-title": { "fr": "Filtres prédéfinis" },
      "type": "array",
      "items": {
        "type": "object",
        "default": {
          "type": "in"
        },
        "required": ["type"],
        "oneOf": [
          {
            "title": "Restrict to values",
            "x-i18n-title": { "fr": "Restreindre à des valeurs" },
            "required": ["field"],
            "properties": {
              "type": {
                "const": "in"
              },
              "field": {
                "$ref": "#/definitions/filterField"
              },
              "values": {
                "type": "array",
                "title": "Values",
                "x-i18n-title": { "fr": "Valeurs" },
                "items": {
                  "type": "string"
                },
                "layout": {
                  "getItems": {
                    "url": "${rootData.config.dataset.href}/values/${parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true"
                  }
                }
              }
            }
          },
          {
            "title": "Restrict to a value range",
            "x-i18n-title": { "fr": "Restreindre à un interval de valeurs" },
            "required": ["field"],
            "properties": {
              "type": {
                "const": "interval"
              },
              "field": {
                "$ref": "#/definitions/filterField"
              },
              "minValue": {
                "type": "string",
                "title": "Min value",
                "x-i18n-title": { "fr": "Valeur min" },
                "layout": {
                  "getItems": {
                    "url": "${rootData.config.dataset.href}/values_agg?field=${parent.data.field.key}&sort=${parent.data.field.key}&${parent.data.field.key}_gte={q}&stringify=true",
                    "itemsResults": "data.aggs",
                    "itemTitle": "item.value",
                    "itemValue": "JSON.stringify(item.value)"
                  }
                }
              },
              "maxValue": {
                "type": "string",
                "title": "Max value",
                "x-i18n-title": { "fr": "Valeur max" },
                "layout": {
                  "getItems": {
                    "url": "${rootData.config.dataset.href}/values_agg?field=${parent.data.field.key}&sort=-${parent.data.field.key}&${parent.data.field.key}_lte={q}&stringify=true",
                    "itemsResults": "data.aggs",
                    "itemTitle": "item.value",
                    "itemValue": "JSON.stringify(item.value)"
                  }
                }
              }
            }
          },
          {
            "title": "Exclude values",
            "x-i18n-title": { "fr": "Exclure des valeurs" },
            "required": ["field"],
            "properties": {
              "type": {
                "const": "out"
              },
              "field": {
                "$ref": "#/definitions/filterField"
              },
              "values": {
                "type": "array",
                "title": "Values to exclude",
                "x-i18n-title": { "fr": "Valeurs à exclure" },
                "items": {
                  "type": "string"
                },
                "layout": {
                  "getItems": {
                    "url": "${rootData.config.dataset.href}/values/${parent.data.field.key}?q={q}&q_mode=complete&size=100&stringify=true"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "filterField": {
      "type": "object",
      "title": "Filter column",
      "x-i18n-title": { "fr": "Colonne de filtre" },
      "layout": {
        "getItems": {
          "url": "${rootData.config.dataset.href}/schema?calculated=false",
          "itemTitle": "item.label",
          "itemKey": "item.key"
        }
      }
    }
  }
}
